# ── Gemini backend ──────────────────────────────────────────────────────────
# Where Gemini calls go: 'vertex' (OAuth via your GCP service account / ADC) or
# 'studio' (an AI Studio API key). Unset, it infers: Vertex if a project is set and
# no key is present, otherwise the key.
AI_BACKEND=vertex

# Vertex AI: the project that holds the quota/credits, and the region to call.
# 'global' has the widest model availability; regional endpoints also work.
GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_AI_LOCATION=global

# AI Studio path only (leave empty when AI_BACKEND=vertex).
GEMINI_API_KEY=

# Gemini models. GEMINI_VISION_MODEL is used for scanned-PDF OCR and falls back to GEMINI_MODEL.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── Application ─────────────────────────────────────────────────────────────
FLASK_ENV=development
MAX_FILE_SIZE=10485760
SESSION_TIMEOUT=3600
PORT=8080
SECRET_KEY=change-me-in-production

# ── RAG ─────────────────────────────────────────────────────────────────────
# Vector database queried at runtime: chroma | qdrant.
# 'chroma' is the default (Qdrant's local mode single-locks its folder per process).
VECTOR_DB=chroma
# Embedding model, held constant across both vector DBs so the comparison stays fair.
EMBEDDING_MODEL=law-ai/InLegalBERT
# Where the prebuilt index lives. Defaults to <repo>/knowledge_base/vector_store/chroma;
# the container image sets this explicitly.
# CHROMA_PATH=/app/knowledge_base/vector_store/chroma
# Optional running Qdrant server; if set, used instead of the local on-disk store.
# QDRANT_URL=http://localhost:6333
# Retrieval budget per legal-KB doc_type (keeps judgments from drowning out statutes).
# TOP_K_STATUTE=3
# TOP_K_REDFLAG=3
# TOP_K_JUDGMENT=2
# TOP_K_DOC=5

# ── WhatsApp (optional) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
